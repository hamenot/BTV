<?xml version="1.0" encoding="utf-8"?><!--
  调试（debug）网络安全配置。

  与 `src/main/res/xml/network_security_config.xml` 的唯一差异：额外信任**用户安装的 CA**，
  便于在真机/模拟器上用 Charles、mitmproxy 之类工具抓包调试。

  仅在 debug 变体生效（资源同名覆盖），release 包不含本文件。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
