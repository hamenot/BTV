<?xml version="1.0" encoding="utf-8"?><!--
  数据提取规则（API 31+，对应清单 `android:dataExtractionRules`）。

  云备份与设备间迁移（换机）都要排除凭证与日志：DataStore 里的 SESSDATA /
  access_token、Room `user.auth`、以及含请求 URL 的崩溃日志。

  清单已设 `android:allowBackup="false"`，保留规则是为了防止将来误改开关。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore" />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="crash_logs" />
    </cloud-backup>

    <device-transfer>
        <exclude
            domain="file"
            path="datastore" />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="crash_logs" />
    </device-transfer>
</data-extraction-rules>
